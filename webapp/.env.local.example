# Copy this file to .env.local for local dev (`npm run dev`/`npm run build`).
#
# This app is a static export (see next.config.js) with no server behind it,
# so these values get baked directly into the built JS at `next build` time.
# For Cloudflare Pages, set the same names as build-time environment
# variables in the Pages project's settings (Settings -> Environment
# variables) - a static export has no runtime to read them from later.
#
# All of these come from Firebase console -> Project settings -> General ->
# Your apps -> Web app (the `</>` icon) - see ../firebase/README.md. They are
# safe to expose to the browser: they identify the project, they don't grant
# access on their own - Realtime Database security rules and Firebase Auth
# do that (see ../firebase/database.rules.json).

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890
